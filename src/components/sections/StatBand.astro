---
import tournament from '../../data/tournament.json';
---
<div class="stat-band" style="display:grid; grid-template-columns:repeat(3,1fr); background:#d8242f;">
  <div style="padding:30px 6vw; text-align:center; border-right:1px solid rgba(255,255,255,.2);"><div style="font-family:'Anton',sans-serif; font-size:46px; color:#fff; line-height:1;">20+</div><div style="color:#ffd9db; font-weight:700; font-size:13px; letter-spacing:.12em; margin-top:8px;">PROGRAMS SUPPORTED</div></div>
  <div style="padding:30px; text-align:center; border-right:1px solid rgba(255,255,255,.2);"><div style="font-family:'Anton',sans-serif; font-size:46px; color:#fff; line-height:1;">${tournament.price_foursome}</div><div style="color:#ffd9db; font-weight:700; font-size:13px; letter-spacing:.12em; margin-top:8px;">PER FOURSOME</div></div>
  <div style="padding:30px; text-align:center;"><div style="font-family:'Anton',sans-serif; font-size:46px; color:#fff; line-height:1;">{tournament.holes}</div><div style="color:#ffd9db; font-weight:700; font-size:13px; letter-spacing:.12em; margin-top:8px;">HOLES · SCRAMBLE</div></div>
</div>
