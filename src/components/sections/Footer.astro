---
import contacts from '../../data/contacts.json';
import tournament from '../../data/tournament.json';
import site from '../../data/site.json';

const addressParts = tournament.address.split(', ');
---
<div style="padding:54px 6vw; background:#070f24; color:#aebbe0;">
  <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:40px; flex-wrap:wrap;">
    <div style="display:flex; gap:16px; align-items:center;">
      <img src="assets/warriors-logo.png" alt="Centaurus Warriors Booster Club" style="width:52px; height:52px; object-fit:contain;">
      <div>
        <div style="font-family:'Anton',sans-serif; color:#fff; font-size:20px;">CENTAURUS WARRIORS</div>
        <div style="font-size:12px; letter-spacing:.18em; color:#7fa0ff; font-weight:700;">BOOSTER CLUB</div>
      </div>
    </div>
    <div style="font-size:14px; line-height:1.9;">
      <div style="color:#fff; font-weight:800; margin-bottom:6px;">CONTACT</div>
      Players — {contacts.players.name}<br>
      <a href={`mailto:${contacts.players.email}`} style="color:#aebbe0;">{contacts.players.email}</a><br>
      Sponsorship — {contacts.sponsorship[0].name} &amp; {contacts.sponsorship[1].name}<br>
      <a href={`mailto:${contacts.sponsorship[0].email}`} style="color:#aebbe0;">{contacts.sponsorship[0].email}</a> · <a href={`mailto:${contacts.sponsorship[1].email}`} style="color:#aebbe0;">{contacts.sponsorship[1].email}</a>
    </div>
    <div style="font-size:14px; line-height:1.9;">
      <div style="color:#fff; font-weight:800; margin-bottom:6px;">THE COURSE</div>
      {tournament.venue}<br>
      {addressParts.map((part, idx) => (
        <span>{part}{idx < addressParts.length - 1 ? ', ' : ''}</span>
      ))}
    </div>
    <div style="font-size:14px; line-height:1.9;">
      <div style="color:#fff; font-weight:800; margin-bottom:6px;">CONNECT</div>
      <a href={site.social.facebook} target="_blank" rel="noopener" style="color:#7fa0ff; text-decoration:none;">Facebook</a>
    </div>
  </div>
  <div style="border-top:1px solid rgba(255,255,255,.1); margin-top:28px; padding-top:18px; font-size:13px; color:#6f7da6;">{site.copyright}</div>
</div>
