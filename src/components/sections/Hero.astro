---
import forms from '../../data/forms.json';
---
<div style="position:relative; height:680px; overflow:hidden; background:linear-gradient(125deg,#0b1838 0%,#14275e 55%,#0b1838 100%);">
  <div class="hero-img-panel" style="position:absolute; right:0; top:0; bottom:0; width:50%; z-index:1;">
    <img id="hero-photo" src="assets/course-2.jpg" alt="Golfer teeing off with Colorado mountain backdrop at Indian Peaks Golf Course" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center;">
    <div style="position:absolute; inset:0; background:linear-gradient(90deg,#0b1838 0%, rgba(11,24,56,.65) 35%, rgba(11,24,56,.15) 100%); pointer-events:none;"></div>
  </div>
  <div style="position:absolute; left:-60px; top:50%; transform:translateY(-50%); width:520px; height:520px; border-radius:50%; background:radial-gradient(circle at 40% 40%, rgba(216,36,47,.4), transparent 65%); filter:blur(12px); z-index:2;"></div>

  <div id="spot-golf" class="spot" style="position:absolute; inset:0; z-index:3; display:flex; flex-direction:column; justify-content:center; padding:0 6vw; transform:translateX(0%);">
    <div style="display:inline-flex; align-items:center; gap:10px; background:#d8242f; color:#fff; font-weight:800; font-size:13px; letter-spacing:.16em; padding:8px 16px; border-radius:3px; width:max-content;">NOW REGISTERING · 2ND ANNUAL</div>
    <h1 style="font-family:'Anton',sans-serif; font-weight:400; font-size:96px; line-height:.92; color:#fff; margin:22px 0 0; letter-spacing:.01em; max-width:680px; text-shadow:0 2px 24px rgba(0,0,0,.35);">CENTAURUS<br>GOLF TOURNAMENT</h1>
    <div style="display:flex; flex-wrap:wrap; gap:22px; margin-top:24px; color:#cdd6ee; font-weight:700; font-size:17px;">
      <span>SUN · SEPT 20, 2026</span><span class="hero-sep" style="color:#5e74b3;">|</span><span>9AM SHOTGUN START</span><span class="hero-sep" style="color:#5e74b3;">|</span><span>INDIAN PEAKS GOLF COURSE</span>
    </div>
    <div class="hero-cta" style="display:flex; gap:14px; margin-top:34px;">
      <button class="form-trigger" data-form-src={forms.registration} data-form-title="TOURNAMENT REGISTRATION" style="background:#d8242f; color:#fff; font-family:'Archivo',sans-serif; font-weight:800; font-size:16px; letter-spacing:.04em; padding:16px 30px; border-radius:3px; border:none; cursor:pointer;">REGISTER A FOURSOME →</button>
    </div>
  </div>

  <div id="spot-mission" class="spot" style="position:absolute; inset:0; z-index:3; display:flex; flex-direction:column; justify-content:center; padding:0 6vw; transform:translateX(100%); pointer-events:none;">
    <div style="display:inline-flex; align-items:center; gap:10px; background:rgba(255,255,255,.14); color:#fff; font-weight:800; font-size:13px; letter-spacing:.16em; padding:8px 16px; border-radius:3px; width:max-content;">SUPPORTING CHS ATHLETICS</div>
    <h1 style="font-family:'Anton',sans-serif; font-weight:400; font-size:96px; line-height:.92; color:#fff; margin:22px 0 0; letter-spacing:.01em; max-width:700px; text-shadow:0 2px 24px rgba(0,0,0,.35);">EVERY WARRIOR.<br>EVERY <span style="color:#d8242f;">TEAM.</span></h1>
    <p style="color:#cdd6ee; font-size:19px; line-height:1.5; max-width:540px; margin:24px 0 0; font-weight:500;">We fund the gear, travel, and grants that let Centaurus athletes compete and grow. Join the club that backs every program.</p>
    <div class="hero-cta" style="display:flex; gap:14px; margin-top:34px;">
      <a href="#sponsor" style="background:#fff; color:#0b1838; text-decoration:none; font-weight:800; font-size:16px; letter-spacing:.04em; padding:16px 30px; border-radius:3px;">GET INVOLVED</a>
      <a href="#donate" style="background:rgba(255,255,255,.06); color:#fff; text-decoration:none; font-weight:800; font-size:16px; letter-spacing:.04em; padding:16px 30px; border-radius:3px; border:2px solid rgba(255,255,255,.35);">DONATE</a>
    </div>
  </div>

  <div style="position:absolute; bottom:26px; left:6vw; display:flex; gap:9px; z-index:5;">
    <span id="dot-golf" style="width:34px; height:5px; border-radius:3px; background:#d8242f; transition:background .5s; cursor:pointer;"></span>
    <span id="dot-mission" style="width:34px; height:5px; border-radius:3px; background:rgba(255,255,255,.3); transition:background .5s; cursor:pointer;"></span>
  </div>
</div>

<script is:inline>
(function () {
  var spots = [document.getElementById('spot-golf'), document.getElementById('spot-mission')];
  var dots  = [document.getElementById('dot-golf'),  document.getElementById('dot-mission')];
  var i = 0;
  var len = spots.length;

  function show(n) {
    if (n === i && spots[n].style.transform === 'translateX(0%)') return;
    var incoming = spots[n];
    var outgoing = spots[i];
    incoming.style.transition = 'none';
    incoming.style.transform = 'translateX(100%)';
    incoming.style.pointerEvents = 'none';
    incoming.offsetWidth;
    incoming.style.transition = '';
    incoming.style.transform = 'translateX(0%)';
    incoming.style.pointerEvents = '';
    outgoing.style.transform = 'translateX(-100%)';
    outgoing.style.pointerEvents = 'none';
    i = n;
    dots.forEach(function (d, k) { if (d) d.style.background = k === n ? '#d8242f' : 'rgba(255,255,255,.3)'; });
  }

  function advance() { show((i + 1) % len); }
  var timer = setInterval(advance, 7000);

  dots.forEach(function (d, k) {
    if (!d) return;
    d.style.cursor = 'pointer';
    d.addEventListener('click', function () { clearInterval(timer); show(k); timer = setInterval(advance, 7000); });
  });

  spots.forEach(function (s) {
    if (!s) return;
    s.querySelectorAll('button, a').forEach(function (btn) {
      btn.addEventListener('mouseenter', function () { clearInterval(timer); });
      btn.addEventListener('mouseleave', function () { timer = setInterval(advance, 7000); });
    });
  });
})();
</script>
