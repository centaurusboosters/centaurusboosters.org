---
import tournament from '../../data/tournament.json';
---
<div id="golf" style="padding:84px 6vw; background:#0b1838; scroll-margin-top:72px;">
  <div style="display:flex; align-items:center; gap:12px; color:#7fa0ff; font-weight:800; font-size:13px; letter-spacing:.18em;"><span style="width:30px; height:2px; background:#d8242f;"></span>THE MAIN EVENT</div>
  <h2 style="font-family:'Anton',sans-serif; font-size:58px; color:#fff; margin:14px 0 0; line-height:.98;">A DAY OF GOLF, FOOD &amp; FUN</h2>
  <p style="color:#aebbe0; font-size:18px; line-height:1.6; max-width:620px; margin:16px 0 0;">Come support Centaurus High School Athletics while you enjoy a day golfing 18 holes at Indian Peaks. Warm up with complimentary range balls, then play a team scramble.</p>
  <div class="event-grid" style="display:grid; grid-template-columns:1.1fr .9fr; gap:36px; margin-top:42px; align-items:stretch;">
    <img id="event-photo" src="assets/course-1.jpg" alt="Golfer swinging at Indian Peaks Golf Course during the Centaurus Warriors tournament" style="min-height:380px; width:100%; border-radius:6px; object-fit:cover; object-position:center; display:block;">
    <div style="display:flex; flex-direction:column; gap:14px;">
      <div style="background:#13265a; border-radius:4px; padding:22px 24px; border-left:4px solid #d8242f;">
        <div style="color:#fff; font-weight:800; font-size:18px;">18-Hole Scramble · Teams of 4</div>
        <div style="display:flex; flex-wrap:wrap; gap:10px 20px; margin-top:10px;">
          {tournament.inclusions.map((item) => (
            <span style="color:#aebbe0; font-size:14px; font-weight:600;">✓ {item}</span>
          ))}
        </div>
      </div>
      <div style="background:#13265a; border-radius:4px; padding:22px 24px; border-left:4px solid #d8242f;">
        <div style="color:#fff; font-weight:800; font-size:18px;">Event-Day Add-Ons</div>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px 16px; margin-top:10px;">
          {tournament.add_ons.map((item) => (
            <span style="color:#aebbe0; font-size:14px; font-weight:600;">{item}</span>
          ))}
        </div>
        <div style="color:#7fa0ff; font-size:12px; margin-top:10px; font-style:italic;">Purchased day-of at the course</div>
      </div>
      <div style="background:#13265a; border-radius:4px; padding:22px 24px; border-left:4px solid #d8242f;">
        <div style="color:#fff; font-weight:800; font-size:18px;">Silent Auction</div>
        <div style="color:#aebbe0; font-size:15px; margin-top:6px; line-height:1.5;">{tournament.auction_description}</div>
      </div>
      <div style="display:flex; gap:28px; padding:8px 4px 0; color:#fff;">
        <div><div style="font-family:'Anton',sans-serif; font-size:32px;">${tournament.price_player}</div><div style="color:#aebbe0; font-size:13px; font-weight:700;">PER PLAYER</div></div>
        <div><div style="font-family:'Anton',sans-serif; font-size:32px;">${tournament.price_foursome}</div><div style="color:#aebbe0; font-size:13px; font-weight:700;">FOURSOME</div></div>
      </div>
    </div>
  </div>
</div>
