<div id="form-modal" role="dialog" aria-modal="true" aria-labelledby="form-modal-title">
  <div id="form-modal-back"></div>
  <div id="form-modal-box">
    <div id="form-modal-head">
      <span id="form-modal-title"></span>
      <button id="form-modal-close" aria-label="Close">✕</button>
    </div>
    <iframe id="form-modal-iframe" src="" title="" frameborder="0" marginheight="0" marginwidth="0">Loading…</iframe>
  </div>
</div>

<script is:inline>
(function () {
  var modal = document.getElementById('form-modal');
  var iframe = document.getElementById('form-modal-iframe');
  var titleEl = document.getElementById('form-modal-title');
  var closeBtn = document.getElementById('form-modal-close');
  var backdrop = document.getElementById('form-modal-back');
  function open(src, title) {
    titleEl.textContent = title || '';
    iframe.src = src;
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    modal.classList.remove('open');
    iframe.src = '';
    document.body.style.overflow = '';
  }
  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') close(); });
  document.querySelectorAll('.form-trigger').forEach(function (btn) {
    btn.addEventListener('click', function () {
      open(btn.dataset.formSrc, btn.dataset.formTitle);
    });
  });
})();
</script>
