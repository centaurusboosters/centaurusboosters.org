---
import { getCollection, render } from 'astro:content';
import forms from '../../data/forms.json';

const grants = await getCollection('grants');
const teamGrant = grants.find(g => g.id === 'team-grants');
const seniorScholarship = grants.find(g => g.id === 'senior-scholarships');

const { Content: TeamContent } = await render(teamGrant);
const { Content: SeniorContent } = await render(seniorScholarship);
---
<div id="grants" style="padding:84px 6vw; background:#fff; scroll-margin-top:72px;">
  <div class="grants-grid" style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
    <!-- Team Grants (navy) -->
    <div style="background:#0b1838; border-radius:6px; padding:42px; color:#fff;">
      <div style="color:#7fa0ff; font-weight:800; font-size:13px; letter-spacing:.16em;">{teamGrant.data.audience.toUpperCase()}</div>
      <h3 style="font-family:'Anton',sans-serif; font-size:38px; margin:10px 0 12px; text-transform:uppercase;">{teamGrant.data.title}</h3>
      <div style="color:#aebbe0; font-size:15px; line-height:1.6; margin:0 0 22px;"><TeamContent /></div>
      <button class="form-trigger" data-form-src={forms[teamGrant.data.form]} data-form-title="TEAM GRANT APPLICATION" style="background:#d8242f; color:#fff; font-weight:800; font-size:14px; padding:13px 24px; border-radius:3px; border:none; cursor:pointer; font-family:'Archivo',sans-serif;">{teamGrant.data.cta_label} →</button>
    </div>
    <!-- Senior Scholarships (red) -->
    <div style="background:#d8242f; border-radius:6px; padding:42px; color:#fff;">
      <div style="color:#ffd0d3; font-weight:800; font-size:13px; letter-spacing:.16em;">{seniorScholarship.data.audience.toUpperCase()}</div>
      <h3 style="font-family:'Anton',sans-serif; font-size:38px; margin:10px 0 12px; text-transform:uppercase;">{seniorScholarship.data.title}</h3>
      <div style="color:#ffe0e2; font-size:15px; line-height:1.6; margin:0 0 22px;"><SeniorContent /></div>
      <button class="form-trigger" data-form-src={forms[seniorScholarship.data.form]} data-form-title="SENIOR SCHOLARSHIP APPLICATION" style="background:#fff; color:#d8242f; font-weight:800; font-size:14px; padding:13px 24px; border-radius:3px; border:none; cursor:pointer; font-family:'Archivo',sans-serif;">{seniorScholarship.data.cta_label} →</button>
    </div>
  </div>
</div>
