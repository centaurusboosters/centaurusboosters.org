---
import forms from '../../data/forms.json';
---
<div id="getinvolved" style="padding:84px 6vw; background:#0b1838; scroll-margin-top:72px;">
  <div style="text-align:center; margin-bottom:38px;">
    <div style="color:#7fa0ff; font-weight:800; font-size:13px; letter-spacing:.18em;">GET INVOLVED</div>
    <h2 style="font-family:'Anton',sans-serif; font-size:46px; color:#fff; margin:12px 0 0;">WAYS TO BACK THE WARRIORS</h2>
  </div>
  <div class="ways-grid" style="display:grid; grid-template-columns:repeat(3,1fr); gap:20px;">
    <button class="form-trigger" data-form-src={forms.sponsorship} data-form-title="SPONSORSHIP INQUIRY" style="text-align:left; cursor:pointer; border:none; background:linear-gradient(160deg,#16285c,#0e1d45); border-radius:5px; padding:34px; border-top:4px solid #d8242f; display:block; width:100%;"><div style="color:#fff; font-family:'Anton',sans-serif; font-size:28px;">SPONSOR</div><p style="color:#aebbe0; font-size:15px; line-height:1.55;">Banner placement, Warrior TV, tournament promotion &amp; a free foursome. Annual or sport-specific options.</p><span style="color:#7fa0ff; font-weight:800; font-size:14px;">See packages →</span></button>
    <button class="form-trigger" data-form-src={forms.donate} data-form-title="DONATE" style="text-align:left; cursor:pointer; border:none; background:linear-gradient(160deg,#16285c,#0e1d45); border-radius:5px; padding:34px; border-top:4px solid #d8242f; display:block; width:100%;"><div style="color:#fff; font-family:'Anton',sans-serif; font-size:28px;">DONATE</div><p style="color:#aebbe0; font-size:15px; line-height:1.55;">Every dollar funds gear, travel, grants &amp; scholarships for Centaurus athletes.</p><span style="color:#7fa0ff; font-weight:800; font-size:14px;">Give now →</span></button>
    <div style="background:linear-gradient(160deg,#16285c,#0e1d45); border-radius:5px; padding:34px; border-top:4px solid #d8242f;"><div style="color:#fff; font-family:'Anton',sans-serif; font-size:28px;">SHOP MERCH</div><p style="color:#aebbe0; font-size:15px; line-height:1.55;">Rep the Warriors. Proceeds go straight back to the programs.</p><span style="display:inline-block; color:#7fa0ff; font-weight:800; font-size:13px; letter-spacing:.06em; border:1px solid rgba(127,160,255,.35); padding:5px 12px; border-radius:3px;">COMING SOON</span></div>
  </div>
</div>
