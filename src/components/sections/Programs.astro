---
import programs from '../../data/programs.json';
---
<div style="padding:60px 6vw; background:#0b1838;">
  <div style="text-align:center; margin-bottom:28px;">
    <div style="display:flex; align-items:center; justify-content:center; gap:12px; color:#7fa0ff; font-weight:800; font-size:13px; letter-spacing:.18em;"><span style="width:30px; height:2px; background:#d8242f;"></span>PROGRAMS WE SUPPORT<span style="width:30px; height:2px; background:#d8242f;"></span></div>
    <p style="color:#aebbe0; font-size:16px; margin:10px 0 0; line-height:1.5;">Every Centaurus team. Every season. We've got them covered.</p>
  </div>
  <div style="display:flex; flex-wrap:wrap; justify-content:center; gap:10px; max-width:860px; margin:0 auto;">
    {programs.map((program) => (
      <span style="background:#13265a; color:#cdd6ee; font-weight:700; font-size:13px; letter-spacing:.06em; padding:8px 18px; border-radius:3px;">{program}</span>
    ))}
    <span style="background:#d8242f; color:#fff; font-weight:700; font-size:13px; letter-spacing:.06em; padding:8px 18px; border-radius:3px;">+ more</span>
  </div>
</div>
