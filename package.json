{
  "name": "centaurus-boosters-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:preview && astro build",
    "build:preview": "node_modules/.bin/esbuild src/admin/preview.jsx --bundle --outfile=public/admin/preview.js --format=iife --global-name=__DecapPreviews --jsx=automatic --define:process.env.NODE_ENV='\"production\"'",
    "dev": "astro dev",
    "validate": "npm run build && bash scripts/validate-site.sh dist"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "^5.0.7",
    "astro": "^6.4.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true
  }
}
